{
  "name": "gntd-search",
  "displayName": "Gntd search",
  "version": "0.0.1",
  "description": "Glass New Tab Dashboard",
  "author": "Prawal",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@mantine/core": "^8.3.16",
    "@mantine/form": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@tabler/icons-react": "^3.39.0",
    "dayjs": "^1.11.19",
    "localforage": "^1.10.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.6.0",
    "styled-components": "^6.3.11"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/react-redux": "^7.1.34",
    "prettier": "3.2.4",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "tabs"
    ],
    "host_permissions": [
      "https://*/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/delta-flyer.html"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  }
}
